EDITOR=vim

# Web UI port (default 3456)
PORT=3456
# Dev (pnpm dev) only, for WSL: set 1 when the project is on a Windows drive (/mnt/c/...). File
# change events do not reach WSL from there, so edits are not picked up until pnpm dev is restarted;
# polling finds them (a little more CPU). Leave 0 on Linux, macOS, or a project inside WSL's own disk.
VITE_POLLING=0
# pm2 process name used by start.sh / stop.sh
PM2_NAME=taskmgr

# Sync daemon (./taskmgrd.sh, see README "Sync daemon"): TASKMGRD_TOKEN is a secret shared by both sides.
# On the machine with the tasks, TASKMGRD_SERVER is the tm server to push to (the URL of its web UI);
# on that server, the token alone turns receiving on (into its data/origins/).
# TASKMGRD_SERVER=https://tm.example.com
# TASKMGRD_TOKEN=change-me
# Polling: TASKMGRD_POLLING=1 makes the daemon also pull from the server (what `tm pull` does: changes made
# there, or pushed by another machine, come here) once when it starts and then every
# TASKMGRD_POLLING_INTERVAL seconds (default 600, ten minutes). 0 (or unset): the daemon only pushes.
# TASKMGRD_POLLING=0
# TASKMGRD_POLLING_INTERVAL=600
