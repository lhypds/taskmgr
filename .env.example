EDITOR=vim

# Web UI: works / projects and their task folders live in taskmgr.json (see taskmgr.json.example).
# TASKMGR_CONFIG=~/taskmgr.json  # optional: use a config file elsewhere
# TASKMGR_USERS=~/taskmgr-users.json  # optional: web UI login accounts elsewhere (default data/users.json here)
# Web UI port (default 3456)
PORT=3456
# pm2 process name used by start.sh / stop.sh
PM2_NAME=taskmgr
