EDITOR=vim

# Web UI port (default 3456)
PORT=3456
# pm2 process name used by start.sh / stop.sh
PM2_NAME=taskmgr

# Sync daemon (./taskmgrd.sh, see README "Sync daemon"): TASKMGRD_TOKEN is a secret shared by both sides.
# On the machine with the tasks, TASKMGRD_SERVER is the tm server to push to (the URL of its web UI);
# on that server, the token alone turns receiving on (into its data/origins/).
# TASKMGRD_SERVER=https://tm.example.com
# TASKMGRD_TOKEN=change-me
# pm2 process name used by taskmgrd.sh (default taskmgrd)
# TASKMGRD_PM2_NAME=taskmgrd
