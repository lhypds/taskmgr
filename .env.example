EDITOR=vim

# Web UI port (default 3456)
PORT=3456
# pm2 process name used by start.sh / stop.sh
PM2_NAME=taskmgr

# Sync (taskmgrd, tm push, tm pull; see docs/taskmgrd.md): SYNC_SERVER is the tm server to sync with
# (the URL of its web UI) and SYNC_SERVER_TOKEN a secret shared by both sides; on that server, the
# token alone turns receiving on (into its data/origins/). With SYNC_SERVER set, ./start.sh starts
# taskmgrd, the sync daemon, with the web UI; empty, it does not.
SYNC_SERVER=
SYNC_SERVER_TOKEN=

# What the daemon does. PUSHING=1: it watches the tasks folders and pushes what changes to the server
# (0: it does not push). POLLING=1: it also pulls from the server (what `tm pull` does: changes made there,
# or pushed by another machine, come here) once when it starts and then every POLLING_INTERVAL seconds
# (600: ten minutes). With both 0 it has nothing to do and does not start.
PUSHING=1
POLLING=0
POLLING_INTERVAL=600

# Dev (pnpm dev) only, for WSL: set 1 when the project is on a Windows drive (/mnt/c/...). File
# change events do not reach WSL from there, so edits are not picked up until pnpm dev is restarted;
# polling finds them (a little more CPU). Leave 0 on Linux, macOS, or a project inside WSL's own disk.
VITE_POLLING=0
